# Copy to demo.env (git-ignored) and fill in.
# A gitlab.com group you created in the UI (top-level groups can't be created via API).
# Projects config-tde-dev5, config-tde-dev5-{dev,staging,prod} and demo-app are created inside it.
GITLAB_GROUP=your-group/dev5-demo
# Personal access token, scopes: api, write_repository, read_registry. Give it a short expiry.
# Used by Kargo (push env repos, open MRs), the setup scripts, and as the GITLAB_PAT
# CI variable for the diff-preview note + Renovate.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
